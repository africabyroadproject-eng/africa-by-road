# ============================================
# Server
# ============================================
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000

# ============================================
# MongoDB Connection
# ============================================
# Example: mongodb://localhost:27017/africa-by-road
# For production on Render, use the connection string from MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/africa-by-road
MONGODB_TEST_URI=

# ============================================
# JWT
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ============================================
# MeCash Payment Integration (Nigeria)
# ============================================
MECASH_API_KEY=your-mecash-api-key-here
MECASH_PUBLIC_KEY=your-mecash-public-key-here
MECASH_WEBHOOK_SECRET=your-mecash-webhook-secret-here
MECASH_MODE=sandbox

# ============================================
# Paystack Payment Integration (fallback)
# ============================================
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# ============================================
# Payment Callback URL (frontend redirect after payment)
# ============================================
PAYMENT_CALLBACK_URL=http://localhost:3000/registration/continue

# ============================================
# Email Provider (sendgrid | smtp)
# ============================================
# Choose email provider: sendgrid or smtp (defaults to sendgrid if empty)
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=your_verified_sender@email.com

# SendGrid Settings (used when EMAIL_PROVIDER=sendgrid)
# For development, emails are logged to console when SENDGRID_API_KEY is empty
SENDGRID_API_KEY=

# SMTP Settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Frontend (CORS allowlist; comma-separate multiple trusted origins)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# Private document storage (Cloudinary)
# ============================================
# Files are uploaded as authenticated assets; never store sensitive documents
# on Render's ephemeral filesystem.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep API documentation disabled in production unless explicitly needed.
ENABLE_SWAGGER=false



# ============================================
# Logging
# ============================================
# Audit and error logs go to stdout (Nest Logger) so they survive Render's
# ephemeral filesystem — no log file path to configure anymore.
