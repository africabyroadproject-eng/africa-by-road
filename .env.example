# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ============================================
# MongoDB Connection
# ============================================
# Example: mongodb://localhost:27017/africa-by-road
# For production on Render, use the connection string from your MongoDB addon
MONGODB_URI=mongodb://localhost:27017/africa-by-road
MONGODB_TEST_URI=

# ============================================
# JWT
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ============================================
# MeCash Payment Integration (Nigeria)
# ============================================
MECASH_API_KEY=your-mecash-api-key-here
MECASH_PUBLIC_KEY=your-mecash-public-key-here
MECASH_WEBHOOK_SECRET=your-mecash-webhook-secret-here
MECASH_MODE=sandbox

# ============================================
# Paystack Payment Integration (fallback)
# ============================================
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# ============================================
# Payment Callback URL (frontend redirect after payment)
# ============================================
PAYMENT_CALLBACK_URL=http://localhost:3000/api/payments/callback

# ============================================
# Email (SendGrid)
# ============================================
# For development, emails are logged to console when SENDGRID_API_KEY is empty
SENDGRID_API_KEY=
EMAIL_FROM=your_verified_sender@email.com

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Frontend (CORS — currently allows all origins)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# Logging
# ============================================
AUDIT_LOG_FILE=audit.log
ERROR_LOG_FILE=error.log
